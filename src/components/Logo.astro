---
import { Image } from 'astro:assets';
import logoImage from '../assets/images/Logo_3.png';
---

<span class="self-center ml-2 rtl:ml-0 rtl:mr-2 whitespace-nowrap">
  <Image
    src={logoImage}
    alt="El Bombet"
    class="h-10 md:h-12 w-auto"
    widths={[100, 200, 300]}
    loading="eager"
    format="webp"
    quality={90}
  />
</span>
