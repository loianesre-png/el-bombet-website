---
import Layout from '~/layouts/PageLayout.astro';

import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
  };
}

const { frontmatter } = Astro.props;

const metadata: MetaData = {
  title: frontmatter?.title,
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl bg-background">
    <div class="text-center mb-8">
      <h1 class="font-heading text-3xl md:text-4xl font-medium text-foreground">{frontmatter.title}</h1>
      <div class="w-20 h-0.5 bg-primary mx-auto mt-4"></div>
    </div>
    <div
      class="mx-auto prose prose-lg max-w-4xl prose-headings:font-heading prose-headings:font-medium prose-headings:text-foreground prose-p:text-muted-foreground prose-li:text-muted-foreground prose-strong:text-foreground prose-a:text-primary hover:prose-a:text-accent prose-img:rounded prose-img:shadow-lg prose-hr:border-muted"
    >
      <slot />
    </div>
  </section>
</Layout>
