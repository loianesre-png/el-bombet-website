---
/**
 * Home Page
 * Main landing page showcasing all apartments
 *
 * Content is loaded from: src/content/dictionary/{locale}/homepage.yaml
 * Services data from: src/data/services.ts
 */
import Layout from '~/layouts/PageLayout.astro';
import HomeHero from '~/components/home/HomeHero.astro';
import ApartmentsOverview from '~/components/home/ApartmentsOverview.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { coreServices } from '~/data/services';
import { getHomepageContent } from '~/utils/content';
import { getSiteName } from '~/config';

import '@/styles/globals.css';

// Load content from dictionary
const homepage = await getHomepageContent();
const siteName = getSiteName();

const metadata = {
  title: `${siteName} - ${homepage.seo.title}`,
  description: homepage.seo.description,
};

// Real guest reviews
const testimonials = [
  {
    testimonial: 'Appartamentino stupendo nel centro storico di Trento. Piccolo ma accogliente, funzionale e nuovissimo. Posizione strategica per girare il centro a piedi. Perfetto per un weekend di coppia o in famiglia! Lorenzo host perfetto, pieno di consigli e sempre disponibile!',
    name: 'Elisa',
    job: 'Italia',
  },
  {
    testimonial: 'Appartamento ristrutturato da poco e studiato in maniera ottimale, casa calda e accogliente in zona centralissima per poter visitare il centro città tranquillamente a piedi',
    name: 'Enrica',
    job: 'Australia',
  },
  {
    testimonial: 'Posto bellissimo e comodo con tutti i servizi ....posizione centrale super comoda per spostarsi a piedi ed arrivare in ogni parte del centro di Trento. La cosa più importante è stata la disponibilità, gentilezza e premura del grande host Lorenzo a cui vanno i nostri ringraziamenti ... ritorneremo presto. Grazie di tutto!!',
    name: 'Antonio',
    job: 'Italia',
  },
  {
    testimonial: 'Posizione comodissima, appartamento molto curato, pulito ed essenziale. Lorenzo è un host super, sempre disponibile.',
    name: 'Jack',
    job: 'USA',
  },
];

// Map core services to Features3 items format
const comfortItems = coreServices.map((service) => ({
  title: service.title,
  description: service.description,
  icon: service.icon,
}));
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <HomeHero />

  <!-- About Section -->
  <section id={homepage.about.section_id} class="py-16 md:py-20 lg:py-28 bg-card">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="font-heading text-3xl md:text-4xl font-medium text-foreground mb-6">
          {homepage.about.title}
        </h2>
        <div class="w-20 h-0.5 bg-primary mx-auto mb-8"></div>
        <div class="prose prose-lg max-w-none text-muted-foreground leading-relaxed">
          <p set:html={homepage.about.description} />
        </div>
      </div>
    </div>
  </section>

  <!-- Apartments Overview Section -->
  <ApartmentsOverview />

  <!-- Comfort/Services Section -->
  <Features3
    id={homepage.comfort.section_id}
    title={homepage.comfort.title}
    subtitle={homepage.comfort.subtitle}
    columns={3}
    defaultIcon="tabler:wifi"
    items={comfortItems}
  />

  <!-- Testimonials Section -->
  <Testimonials
    id={homepage.testimonials.section_id}
    title={homepage.testimonials.title}
    subtitle={homepage.testimonials.subtitle}
    testimonials={testimonials}
  />

  <!-- Call to Action Section -->
  <CallToAction
    id="contact"
    title={homepage.cta.title}
    subtitle={homepage.cta.description}
    actions={[
      {
        variant: 'primary',
        text: homepage.cta.button,
        href: '/contatti',
      },
    ]}
  />
</Layout>
